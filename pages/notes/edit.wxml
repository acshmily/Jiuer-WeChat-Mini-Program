<tg-dissolve playing="{{dissolving}}" host-class="notes-edit-dissolve">
  <view class="tg-page notes-edit">
    <view class="notes-edit-caption">{{isEdit ? '改／札' : '新／札'}}</view>
    <view class="tg-aside">写给自己看的短记。标签只标人、局、险。</view>

    <view class="tg-section">
      <view class="tg-label">标签</view>
      <view class="tg-tag-row notes-edit-tags">
        <view
          wx:for="{{tags}}"
          wx:key="key"
          class="notes-edit-tag notes-edit-tag--{{item.key}} {{tag === item.label ? 'is-on' : ''}}"
          data-tag="{{item.label}}"
          bindtap="pickTag"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="tg-section">
      <view class="tg-label">正文</view>
      <view class="tg-field notes-edit-field">
        <textarea
          class="tg-textarea"
          maxlength="500"
          placeholder="人怎么看、局怎么走、险在哪里——择要记。"
          value="{{body}}"
          bindinput="bodyInput"
        />
      </view>
    </view>

    <button class="tg-primary-btn" bindtap="save">收进札记</button>
    <button class="tg-ghost-btn tg-ghost-btn--danger" wx:if="{{isEdit}}" bindtap="remove">抹去此条</button>
  </view>
</tg-dissolve>
