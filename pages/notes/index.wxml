<view class="tg-page">
  <view class="tg-brow">谋略札记</view>
  <view class="tg-aside">「短记、本地、不外传。人、局、险——标清楚再落笔。」</view>
  <navigator url="edit" class="tg-link" hover-class="none">新开一条</navigator>

  <view class="tg-list" wx:if="{{list.length > 0}}">
    <view class="tg-list-item" wx:for="{{list}}" wx:key="id">
      <navigator url="edit?id={{item.id}}" class="tg-list-main" hover-class="none">
        <view class="tg-list-title">
          <text class="tg-pill">{{item.tag}}</text>{{item.preview}}
        </view>
        <view class="tg-list-meta">{{item.updatedAt}}</view>
      </navigator>
      <view class="tg-list-action" catchtap="remove" data-id="{{item.id}}">抹去</view>
    </view>
  </view>

  <view class="tg-empty" wx:else>
    <view class="tg-empty-line">{{emptyText}}</view>
    <navigator url="edit" class="tg-link" hover-class="none">新开一条</navigator>
  </view>
</view>
