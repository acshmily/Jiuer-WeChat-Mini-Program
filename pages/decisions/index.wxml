<view class="tg-page">
  <view class="tg-brow">呈上抉择</view>
  <view class="tg-daily">
    <view class="tg-daily-tag">今日／军略</view>
    <view class="tg-daily-line">{{aside}}</view>
  </view>
  <view class="tg-link tg-link--quiet" bindtap="openMore">更多谋略</view>

  <view class="tg-section tg-section--tight">
    <view class="tg-label">此局议题</view>
    <view class="tg-field">
      <input class="tg-input" placeholder="可空。写清你在纠结什么。" bindinput="subjectInput" value="{{subject}}" />
    </view>
  </view>

  <view class="tg-section tg-section--tight">
    <view class="tg-label">可走之路</view>
    <block wx:for="{{advice}}" wx:key="*this" wx:for-index="idx">
      <tg-dissolve
        host-class="tg-option"
        layout="row"
        count="14"
        playing="{{dissolvingIdx === idx}}"
      >
        <input id="{{idx}}" class="tg-input" value="{{item}}" placeholder="一条路" bindinput="itemInput" />
        <view class="tg-remove" wx:if="{{idx > 1}}" data-id="{{idx}}" bindtap="delItem">去掉</view>
      </tg-dissolve>
    </block>
    <view class="tg-add" bindtap="addMoreInput">再添一路</view>
  </view>

  <button class="tg-primary-btn tg-primary-btn--loose" bindtap="doChoose">请咎儿定夺</button>
</view>
