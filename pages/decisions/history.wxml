<view class="tg-page">
  <view class="tg-brow">过往定夺</view>
  <view class="tg-aside">「最近三十局。再算一局，只会改原来那条，不会另开新账。」</view>

  <view class="tg-list" wx:if="{{list.length > 0}}">
    <view class="tg-list-item" wx:for="{{list}}" wx:key="id">
      <navigator url="result?id={{item.id}}" class="tg-list-main" hover-class="none">
        <view class="tg-list-title">{{item.subject}}</view>
        <view class="tg-list-meta">{{item.createdAt}} · 当前首选 {{item.top}}</view>
      </navigator>
      <view class="tg-list-action" catchtap="remove" data-id="{{item.id}}">抹去</view>
    </view>
  </view>

  <view class="tg-empty" wx:else>
    <view class="tg-empty-line">{{emptyText}}</view>
    <navigator url="/pages/decisions/index" open-type="reLaunch" class="tg-link" hover-class="none">去呈上一局</navigator>
  </view>
</view>
